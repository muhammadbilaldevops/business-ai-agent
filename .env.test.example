# Copy to .env. Extractive mode needs no model download.
LOCALOPS_MODE=extractive
LOCALOPS_DATA_DIR=data/runtime
LOCALOPS_OLLAMA_URL=http://127.0.0.1:11434
LOCALOPS_MODEL=llama3.1:8b
# Optional bearer token, entered in the local UI Settings. Do not commit it.
LOCALOPS_API_KEY=
# Optional local model directories, prepared explicitly during bootstrap:
LOCALOPS_EMBEDDING_PATH=
LOCALOPS_RERANKER_PATH=
LOCALOPS_STT_PATH=
LOCALOPS_TTS_MODEL=
LOCALOPS_TTS_VOICES=
# For Docker Compose with Ollama: LOCALOPS_MODE=ollama
# Inference models must be downloaded explicitly; see README.
